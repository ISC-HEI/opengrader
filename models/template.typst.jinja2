#import "@preview/isc-hei-document:0.7.1" : *

#show: project.with(
  doc-type: "document",
  show-cover: false,
  show-toc: false,
  fancy-line: false,

  title: "{{ exam.name | replace('--', '–') }}",
  subtitle: [{{ exam.course }}],
  authors: (
    {%- for a in exam.authors -%}
    "{{ a }}"{% if not loop.last %}, {% endif %}
    {%- endfor -%}
  ),

  date: datetime(year: {{ exam.date.year }}, month: {{ exam.date.month }}, day: {{ exam.date.day }}),
  revision: "1.0",
  language: "fr",
  logo: none,

  code-theme: "bluloco-light",
)

// Student name header
*Nom / Name: {{ exam.firstname }} {{ exam.lastname }}*

{% for q in exam.questions %}
#grid(
  columns: (1fr, auto),
  [
    = {% if exam.add_anchors %}Q{{ loop.index0 }}:start {% endif %}{{ q.name }}
  ],
  [
    {% if q.max_point is not none %}#align(right)[{{ q.max_point }} pts]{% endif %}
  ]
)

#[
  #set text(font: "Source Sans 3")
  {{ q.description | markdown_to_typst }}
]

{% if q.answer is not none and q.answer.content is not none %}

#pagebreak()

#grid(
  columns: (1fr, auto),
  [
  == Student answer
  ],
  [
    #stack(dir: ltr, spacing: 1em,
      {% if q.answer.test_results is not none %}[
        {% set tr = q.answer.test_results %}
        {% if tr.error == "compile_error" %}#text(fill: red)[⚠ compile error]
        {% elif tr.error == "timeout" %}#text(fill: red)[⚠ timeout]
        {% elif tr.error == "empty" %}#text(fill: gray)[– pas de code]
        {% elif tr.total > 0 %}
          {% set p = tr.passed %}
          {% set t = tr.total %}
          {% if p == t %}#text(fill: green)[✓ {{ p }}/{{ t }} tests]
          {% elif p == 0 %}#text(fill: red)[✗ {{ p }}/{{ t }} tests]
          {% else %}#text(fill: orange)[~ {{ p }}/{{ t }} tests]
          {% endif %}
        {% endif %}
      ],{% endif %}
      {% if q.answer.points is not none %}[#align(right)[{{ q.answer.points }}/{{ q.max_point }} pts]]{% else %}[]{% endif %}
    )
  ]
)

#code(
  ```{{ q.type }}
{{ q.answer.content }}
  ```
)

{% if q.answer.correction_details is not none %}
#pad(top: 0.5em)[
  *Correction details:*
  #code(
    ```
    {{ q.answer.correction_details }}
    ```
  )
]
{% endif %}

{% endif %}
{% for b in range(q.linebreak) -%}
#pagebreak()
{%- endfor %}

{%- if not loop.last %}
#pagebreak()
{% endif -%}

{% endfor %}
