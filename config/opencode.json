{
  "agent": {
    "open-grader": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "prompt": "{file:./prompts/open-grader.md}",
      "description": "Open grader main agent",
      "steps": 100,
      "color": "#87bf7c",
      "permission": {
        "read": "allow",
        "external_directory": "ask",
        "glob": "allow",
        "edit": "allow",
        "lsp": "allow",
        "skill": "allow",
        "task": "allow",
        "question": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "webfetch": "ask",
        "websearch": "deny",
        "bash": "allow",
        "doom_loop": "deny",
        "codesearch": "allow"
      }
    },
    "pregrade-worker": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-3-flash-preview",
      "description": "Grades one batch of student answers for a single question and writes the result as JSON.",
      "hidden": true,
      "steps": 10,
      "color": "#87bf7c",
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "glob": true,
        "bash": false,
        "task": false,
        "websearch": false,
        "webfetch": false
      }
    }
  }
}
